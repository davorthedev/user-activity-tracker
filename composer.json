{
    "name": "davor-petkovic/user-activity-tracker",
    "description": "Simple web project with track user activity.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/phpstan": "*",
        "phpunit/phpunit": "*"
    }
}
